---
import { siteConfig } from "../../data/site";
---

<section id="contacto" class="contact" aria-labelledby="contact-title">
  <div class="contact-inner content-width">
    <p class="eyebrow">Contact</p>
    <div>
      <h2 id="contact-title">¿Construimos algo que importe?</h2>
      <p>Cuéntanos qué necesitas resolver.</p>
      {
        siteConfig.contact.email && (
          <a class="contact-link" href={`mailto:${siteConfig.contact.email}`}>
            Escríbenos <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(5rem, 9vw, 8rem) clamp(4rem, 7vw, 6rem);
    border-block: 1px solid var(--ms-color-border);
    background: var(--ms-color-surface);
  }
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
  }
  .eyebrow {
    margin: 0.6rem 0 0;
    color: var(--ms-color-system-cyan);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h2 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--ms-font-display);
    font-size: clamp(3rem, 7vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }
  h2 + p {
    margin: 2.5rem 0 0;
    color: var(--ms-color-text-muted);
    font-size: clamp(1rem, 1.7vw, 1.3rem);
  }
  .contact-link {
    display: inline-flex;
    gap: 2.5rem;
    margin-top: 2.5rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--ms-radius-sm);
    background: var(--ms-color-text);
    color: var(--ms-color-background);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  @media (max-width: 43rem) {
    .contact-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
