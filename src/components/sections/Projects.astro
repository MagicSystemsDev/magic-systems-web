---
import { projects } from "../../data/projects";
import BankGProject from "./BankGProject.astro";
import BlackRousProject from "./BlackRousProject.astro";

const bankG = projects.find((project) => project.id === "bank-g");
const blackRous = projects.find((project) => project.id === "black-rous");

if (!bankG || !blackRous) {
  throw new Error("Featured project data is incomplete.");
}
---

<section id="proyectos" class="projects" aria-labelledby="projects-title">
  <div class="projects-intro content-width">
    <p class="eyebrow">Projects</p>
    <div>
      <h2 id="projects-title">Lo que estamos construyendo</h2>
      <p>
        Productos propios y soluciones construidas alrededor de necesidades
        reales.
      </p>
    </div>
  </div>
  <BankGProject project={bankG} />
  <BlackRousProject project={blackRous} />
  <div class="corporate-return" aria-hidden="true"></div>
</section>

<style>
  .projects {
    background: var(--ms-color-surface);
    scroll-margin-top: 5.5rem;
  }
  .projects-intro {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    padding-block: clamp(7rem, 14vw, 12rem);
  }
  .eyebrow {
    margin: 0.55rem 0 0;
    color: var(--ms-color-brand-primary);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h2 {
    max-width: 13ch;
    margin: 0;
    font-family: var(--ms-font-display);
    font-size: clamp(2.6rem, 6vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }
  h2 + p {
    max-width: 37rem;
    margin: 2.25rem 0 0;
    color: var(--ms-color-text-muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
  }
  .corporate-return {
    height: clamp(5rem, 10vw, 9rem);
    background: linear-gradient(180deg, #080608, var(--ms-color-background));
  }
  @media (max-width: 43rem) {
    .projects-intro {
      grid-template-columns: 1fr;
      padding-block: 6rem;
    }
  }
</style>
