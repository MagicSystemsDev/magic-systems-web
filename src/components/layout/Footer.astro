---
import { navigation, siteConfig, withBasePath } from "../../data/site";
import { projects } from "../../data/projects";
---

<footer class="site-footer">
  <div class="footer-grid content-width">
    <div class="footer-brand">
      <a href="#main-content" aria-label="Magic Systems, volver al inicio">
        <img
          src={withBasePath(
            "brand/magic-systems/magic-systems-lockup-horizontal-dark.svg",
          )}
          alt="Magic Systems"
          width="720"
          height="215"
        />
      </a>
      <p>Understand first.<br />Build what matters.</p>
    </div>
    <nav aria-label="Navegación del footer">
      <p class="group-label">Explorar</p>
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="projects">
      <p class="group-label">Projects</p>
      {
        projects.map((project) =>
          project.website ? (
            <a href={project.website} target="_blank" rel="noreferrer">
              {project.name}
            </a>
          ) : (
            <span>{project.name}</span>
          ),
        )
      }
    </div>
    <div class="external">
      <p class="group-label">Código</p>
      <a href={siteConfig.repositoryUrl} target="_blank" rel="noreferrer">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
  <div class="footer-bottom content-width">
    <p>© 2026 Magic Systems</p>
    <a href="#main-content">Volver arriba ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
    background: var(--ms-color-background);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr 0.7fr 0.7fr;
    gap: clamp(2rem, 5vw, 5rem);
  }
  .footer-brand a {
    display: block;
    width: 10rem;
  }
  .footer-brand img {
    width: 100%;
    height: auto;
  }
  .footer-brand p {
    margin: 2rem 0 0;
    color: var(--ms-color-text-muted);
    font-family: var(--ms-font-display);
    line-height: 1.5;
  }
  nav,
  .projects,
  .external {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.7rem;
  }
  .group-label {
    margin: 0 0 0.8rem;
    color: var(--ms-color-brand-primary);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  nav a,
  .projects a,
  .projects span,
  .external a {
    color: var(--ms-color-text-muted);
    font-size: 0.78rem;
    text-decoration: none;
  }
  a:hover {
    color: var(--ms-color-text);
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--ms-color-border);
  }
  .footer-bottom p,
  .footer-bottom a {
    margin: 0;
    color: var(--ms-color-text-muted);
    font-size: 0.68rem;
    text-decoration: none;
  }
  @media (max-width: 48rem) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }
  @media (max-width: 30rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
      margin-bottom: 2rem;
    }
    .external {
      margin-top: 1.5rem;
    }
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
